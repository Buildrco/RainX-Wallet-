{
  "expo": {
    "name": "RainX Wallet",
    "slug": "rainx-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rainx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buildrco.rainxwallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your RainX wallet.",
        "NSCameraUsageDescription": "Camera access is used to scan RainX addresses and QR codes."
      }
    },
    "android": {
      "package": "com.buildrco.rainxwallet",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "51c7f050-8d56-45e3-a045-1a03074dca3f"
      }
    },
    "owner": "desmonegrace85",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/51c7f050-8d56-45e3-a045-1a03074dca3f"
    }
  }
}
